{
  "name": "paytm-seat-reservation",
  "version": "1.0.0",
  "description": "JSON HTTP API that sells assigned seats for a show under heavy contention, without ever double-selling a seat.",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test",
    "burst": "node scripts/burst.js"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true
  }
}
